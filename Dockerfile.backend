# --- Stage 1: Build Binaries ---
FROM golang:alpine AS builder

WORKDIR /app

# Install build dependencies
RUN apk add --no-cache git ca-certificates

# Download Go dependencies
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build stripped static binaries with trimpath
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /bin/api ./cmd/api
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /bin/migrator ./cmd/migrator

# --- Stage 2: Runtime Backend ---
FROM alpine:3.20 AS backend

WORKDIR /app

# Copy system certificates without bloating layers with package managers
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

# Create unprivileged user with built-in busybox utilities
RUN addgroup -S app && adduser -S app -G app

COPY --from=builder /bin/api /bin/api

USER app

EXPOSE 8080

ENTRYPOINT ["/bin/api"]

# --- Stage 3: Runtime Migrator ---
FROM alpine:3.20 AS migrator

WORKDIR /app

COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
RUN addgroup -S app && adduser -S app -G app

COPY --from=builder /bin/migrator /bin/migrator

USER app

ENTRYPOINT ["/bin/migrator"]
